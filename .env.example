# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
VAULT_PATH=/path/to/your/obsidian/vault
# Registry contract (testnet only)
NOTARY_CONTRACT=your-registry.testnet
# Author account that signs publish transactions
NEAR_ACCOUNT_ID=your-author.testnet
NEAR_PRIVATE_KEY=ed25519:...
# Optional, default https://test.rpc.fastnear.com
# NEAR_RPC_URL=
# Pinata JWT with scope org:files:write
PINATA_JWT=
# Optional: your dedicated Pinata gateway, e.g. https://xyz.mypinata.cloud
# IPFS_GATEWAY=
